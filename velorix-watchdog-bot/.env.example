# ============================================================
# VELORIX 24/7 AI WATCHDOG & TELEGRAM ASSISTANT BOT CONFIG
# ============================================================

# 1. TELEGRAM BOT CREDENTIALS (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 2. YOUR PERSONAL TELEGRAM CHAT ID (Get by sending /start to @userinfobot)
ADMIN_TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"

# 3. FIREBASE CONFIGURATION
# VeloRix Project Database URL:
FIREBASE_DATABASE_URL="https://velorix-tournaments-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_PROJECT_ID="velorix-tournaments"

# Path to your Firebase Admin Service Account Key JSON file (Download from Firebase Console -> Project Settings -> Service Accounts)
# Place serviceAccountKey.json in this same folder
SERVICE_ACCOUNT_KEY_PATH="./serviceAccountKey.json"

# 4. GOOGLE GEMINI AI API KEY (Free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 5. WATCHDOG POLLING INTERVAL IN MINUTES (Default: every 3 minutes)
MONITOR_INTERVAL_MINUTES=3
